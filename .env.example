# Server-only foundation values. Use separate local, preview, test, and production resources.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=constructstock
LOG_LEVEL=info

# Required for registration and authentication.
APP_URL=http://localhost:3000
TOKEN_PEPPER=
ALLOWED_ORIGINS=http://localhost:3000
# Required for password reset emails. Verify the sender domain in Resend.
RESEND_API_KEY=
EMAIL_FROM="ConstructStock <security@your-verified-domain.com>"
# Required for optional private wastage photos. Use a private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=
# Required in production for the daily cleanup of abandoned photo uploads.
CRON_SECRET=
# Add when the corresponding feature is implemented.
# SENTRY_DSN=
